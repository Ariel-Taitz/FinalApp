<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinalApp.Views.UserDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="UserDetailPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint=" 0,0 " EndPoint=" 1,1 ">
            <GradientStop Offset=" 0.0 " Color="DarkMagenta" />
            <GradientStop Offset=" 1.0 " Color="DarkBlue" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid ColumnDefinitions="*, 8*,*" RowDefinitions=" 1.5 *, 4*,*">
        <HorizontalStackLayout
            Grid.Column=" 1"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!--  Title  -->
            <Label
                FontSize=" 24 "
                Text="Account Details"
                TextColor="Wheat" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row=" 1" Grid.Column=" 1">

            <!--  First Name Field  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape=" RoundRectangle 8"
                StrokeThickness=" 1">
                <Entry
                    x:Name="FirstNameEntry"
                    FontSize=" 18 "
                    Placeholder="First Name"
                    TextColor="Wheat" />
            </Border>
            <!--  LastName Field  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape=" RoundRectangle 8"
                StrokeThickness=" 1">
                <Entry
                    x:Name="LastNameEntry"
                    FontSize=" 18 "
                    Placeholder="Last Name"
                    TextColor="Wheat" />
            </Border>
            <!--  Email  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape=" RoundRectangle 8"
                StrokeThickness=" 1">
                <Entry
                    x:Name="EmailEntry"
                    FontSize=" 18 "
                    Keyboard="Email"
                    Placeholder="Email"
                    TextColor="Wheat" />
            </Border>
            <!--  Mobile  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape=" RoundRectangle 8"
                StrokeThickness=" 1">
                <Entry
                    x:Name="MobileEntry"
                    FontSize=" 18 "
                    Keyboard="Telephone"
                    Placeholder="Mobile"
                    TextColor="Wheat" />
            </Border>
            <!--  Entry Button  -->
            <Button
                x:Name="UpdateButton"
                Clicked=" UpdateButton_Clicked "
                CornerRadius=" 8"
                FontSize=" 20 "
                HeightRequest=" 70 "
                Text="Update"
                TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>