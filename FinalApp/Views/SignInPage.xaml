<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinalApp.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FinalApp.ViewModels"
    Title="SignInPage"
    x:DataType="views:SignInViewModel">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="Black" />
            <GradientStop Offset="0.5" Color="DarkSlateBlue" />
            <GradientStop Offset="1.0" Color="Black" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <!--  Header  -->
        <Label
            FontAttributes="Bold"
            FontSize="25"
            Text="Enter"
            TextColor="Snow"
            VerticalOptions="Center" />

        <Border
            Padding="10"
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">

            <Entry
                FontSize="18"
                Keyboard="Email"
                Placeholder="Email"
                ReturnType="Go"
                Text="{Binding UserName}"
                TextColor="Wheat" />

        </Border>

        <Border
            Stroke="#ccc"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">

            <Grid
                Padding="10"
                ColumnDefinitions="*,Auto"
                VerticalOptions="Center">

                <Entry
                    BackgroundColor="Transparent"
                    FontSize="18"
                    IsPassword="{Binding EntryAsPassword}"
                    Placeholder="Password"
                    Text="{Binding UserPassword}"
                    TextColor="Wheat"
                    VerticalOptions="Center" />

                <Button
                    Margin="5,0,0,0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ShowPasswordCommand}"
                    FontFamily="MaterialSymbols1"
                    FontSize="24"
                    HorizontalOptions="End"
                    Text="{Binding PasswordIconCode}"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

        </Border>

        <!--  Entry Button  -->
        <Button
            Command="{Binding SignInCommand}"
            CornerRadius="8"
            FontSize="18"
            HeightRequest="50"
            Text="Sign In"
            TextColor="White" />

        <!--  Error  -->
        <Label
            x:Name="errorLbl"
            FontSize="45"
            HorizontalTextAlignment="Center"
            IsVisible="{Binding SignInMessageVisible}"
            Text="{Binding LoginMessage}"
            TextColor="{Binding SignInMessageColor}" />

    </VerticalStackLayout>
</ContentPage>