<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinalApp.Views.UsersListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinalApp.Models"
    xmlns:viewmodels="clr-namespace:FinalApp.ViewModels"
    Title="UsersListPage"
    x:DataType="viewmodels:UsersListViewModel"
    FlowDirection="LeftToRight">

    <Grid RowDefinitions=".13*,.13*,.9*">
        <Grid ColumnDefinitions="7*,3*">
            <Label
                Margin="80,0,0,0"
                FontAttributes="Bold"
                FontSize="30"
                HorizontalOptions="Center"
                Text="Users List"
                TextColor="CadetBlue"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Background="Green"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Add"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>
            <!--  Find && Filter Users 1:10  -->
            <Grid Grid.Row="1" ColumnDefinitions="7*,3*">
                <SearchBar
                    Placeholder="find user"
                    SearchCommand="{Binding SearchCommand}"
                    Text="{Binding SearchText}" />
                <Button
                    Grid.Column="1"
                    Margin="0,0,0,15"
                    Background="Transparent"
                    TextColor="Black"
                    FontFamily="MyMaterialSymbols"
                    Command="{Binding ClearFilterCommand}"
                    Text="{Binding FilterIconCode}" />

            </Grid>
            <!--  Users Collection  -->
        
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding AllUsers}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <!--  ICONS  -->
                            <SwipeItem
                                Command="{Binding Path=ViewAccountPageCommand, Source={x:RelativeSource AncestorType={x:Type viewmodels:UsersListViewModel}}, x:DataType='viewmodels:UsersListViewModel'}"
                                CommandParameter="{Binding .}"
                                IconImageSource="account.png"
                                Text="Watch" />

                            <SwipeItem Text="Delete" Command="{Binding BindingContext.DeleteUserCommand, Source={x:Reference UsersCollection}}" CommandParameter="{Binding .}">
                               
                                <!--  ICONS  -->
                                <SwipeItem.IconImageSource>
                                    <FontImageSource>
                                        <FontImageSource.FontFamily>MaterialSymbols1</FontImageSource.FontFamily>
                                        <FontImageSource.Glyph>&#xe872;</FontImageSource.Glyph>
                                    </FontImageSource>
                                </SwipeItem.IconImageSource>
                            </SwipeItem>
                        </SwipeView.LeftItems>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!--  What Desplays When There Are No Users  -->
            <CollectionView.EmptyView>
                <StackLayout
                    Padding="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Text="Users not found!"
                        TextColor="Gray" />
                    <Label
                        Margin="0,0,0,100"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Text="Pull down to refresh"
                        TextColor="Gray" />

                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>